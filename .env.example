# Supabase Postgres (Transaction pooler, port 6543)
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: local Docker Postgres (docker compose up -d)
# DATABASE_URL=postgresql://rezervo:rezervo@127.0.0.1:54329/rezervo
