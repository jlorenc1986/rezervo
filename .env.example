# Supabase Postgres (Transaction pooler, port 6543)
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: local Docker Postgres (docker compose up -d)
# DATABASE_URL=postgresql://rezervo:rezervo@127.0.0.1:54329/rezervo

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# In Supabase Auth settings:
# - Enable Email provider
# - Add redirect URL: http://localhost:3000/auth/callback
# - Add site URL: http://localhost:3000
# For Railway, add your production URL + /auth/callback
